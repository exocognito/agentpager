{
  "name": "agentpager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check": "tsc --noEmit && pnpm --filter @agentpager/app lint",
    "test": "pnpm --filter @agentpager/blueprint test",
    "test:unit": "pnpm --filter @agentpager/blueprint test",
    "test:app": "node --test --experimental-strip-types --test-concurrency=4 packages/app/test/*.test.ts",
    "test:cli": "pnpm --filter @agentpager/cli build && pnpm --filter @agentpager/cli test",
    "test:all": "pnpm test && pnpm test:app && pnpm test:cli",
    "build:app": "pnpm --filter @agentpager/app build",
    "start:app": "pnpm --filter @agentpager/app start",
    "deploy:app": "pnpm --filter @agentpager/app run deploy",
    "test:dogfood": "pnpm --filter @agentpager/app test:dogfood"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "wrangler": "4.134.0"
  }
}
