{
  "name": "@agentpager/app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "deploy:dev": "node --experimental-strip-types scripts/deploy.mjs --stage dev",
    "deploy:prod": "node --experimental-strip-types scripts/deploy.mjs --stage prod",
    "smoke:dev": "node --experimental-strip-types scripts/smoke.mjs --stage dev",
    "smoke:prod": "node --experimental-strip-types scripts/smoke.mjs --stage prod",
    "lint": "node scripts/lint.mjs",
    "dogfood": "node scripts/dogfood.mjs",
    "designs": "node scripts/designs.mjs",
    "designs:check": "node scripts/designs.mjs --check",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "effect": "3.22.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260924.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "vitest": "4.1.11"
  }
}
