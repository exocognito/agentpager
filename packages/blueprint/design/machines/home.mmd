stateDiagram-v2
  direction TB
  [*] --> home_loading
  state "loading" as home_loading
  state "failed" as home_failed
  state "list" as home_list {
    [*] --> home_list_browse
    state "browse" as home_list_browse
    state "connect" as home_list_connect {
      [*] --> home_list_connect_listening
      state "listening" as home_list_connect_listening
      state "opening" as home_list_connect_opening
    }
  }
  home_loading --> home_list : done
  home_loading --> home_failed : error
  home_loading : invokes load
  home_failed --> home_loading : RETRY
  home_list --> home_list : REFRESH (internal)
  home_list --> home_list : SYNC (internal)
  home_list --> home_list : FAIL (internal)
  home_list : invokes poll
  home_list_browse --> home_list_connect : CONNECT
  home_list_connect --> home_list_browse : BACK
  home_list_connect_listening --> home_list_connect_listening : CONNECT_TRY (internal)
  home_list_connect_listening --> home_list_connect_listening : CONNECT_OPENED [currentTry] (internal)
  home_list_connect_listening --> home_list_connect_listening : CONNECT_FAILED [currentTry] (internal)
  home_list_connect_listening --> home_list_connect_opening : SYNC [agentJoined]
  home_list_connect_listening --> home_list_connect_listening : SYNC (internal)
  home_list_connect_listening : invokes connect
