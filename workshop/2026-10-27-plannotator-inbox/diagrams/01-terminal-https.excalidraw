    {
      "type": "text",
      "id": "1-20",
      "x": 50,
      "y": 625,
      "text": "Model/caller must maintain the wait.\nNo automatic next-turn delivery.",
      "fontSize": 18,
      "strokeColor": "#374151",
      "fontFamily": 2,
      "width": 401.76,
      "height": 45
    },
    {
      "type": "text",
      "id": "1-21",
      "x": 490,
      "y": 625,
      "text": "Service receipt confirms storage.\nAgent acknowledgement is separate.",
      "fontSize": 16,
      "strokeColor": "#374151",
      "fontFamily": 2,
      "width": 337.28,
      "height": 40
    },
    {
      "type": "text",
      "id": "1-22",
      "x": 850,
      "y": 625,
      "text": "Phone polls every 3s today.\nNo direct phone-to-laptop access.",
      "fontSize": 17,
      "strokeColor": "#374151",
      "fontFamily": 2,
      "width": 347.82,
      "height": 42.5
    },
    {
      "type": "text",
      "id": "1-23",
      "x": 28,
      "y": 798,
      "text": "CURRENT CONTRACT · Waits hold up to 50s; caller repeats on pending.",
      "fontSize": 21,
      "strokeColor": "#374151",
      "fontFamily": 2,
      "width": 872.34,
      "height": 26.25
    },
    {
      "type": "text",
      "id": "1-24",
      "x": 28,
      "y": 835,
      "text": "Agent machine must be awake and online. AgentPager carries the decision; Codex executes the work.",
      "fontSize": 18,
      "strokeColor": "#62677d",
      "fontFamily": 2,
      "width": 1082.52,
      "height": 22.5
    }
