    {
      "type": "text",
      "id": "3b-21",
      "x": 50,
      "y": 625,
      "text": "Helper waits outside the model.\nIdle session can start a new turn.",
      "fontSize": 18,
      "strokeColor": "#374151",
      "fontFamily": 2,
      "width": 379.44,
      "height": 45
    },
    {
      "type": "text",
      "id": "3b-22",
      "x": 490,
      "y": 625,
      "text": "Service receipt confirms storage.\nAgent acknowledgement is separate.",
      "fontSize": 16,
      "strokeColor": "#374151",
      "fontFamily": 2,
      "width": 337.28,
      "height": 40
    },
    {
      "type": "text",
      "id": "3b-23",
      "x": 850,
      "y": 625,
      "text": "Phone polls every 3s today.\nNo direct phone-to-laptop access.",
      "fontSize": 17,
      "strokeColor": "#374151",
      "fontFamily": 2,
      "width": 347.82,
      "height": 42.5
    },
    {
      "type": "text",
      "id": "3b-24",
      "x": 28,
      "y": 798,
      "text": "PROPOSED · Existing held reads first; outbound WSS is a later transport option.",
      "fontSize": 21,
      "strokeColor": "#374151",
      "fontFamily": 2,
      "width": 1028.58,
      "height": 26.25
    },
    {
      "type": "text",
      "id": "3b-25",
      "x": 28,
      "y": 835,
      "text": "Agent machine must be awake and online. AgentPager carries the decision; Codex executes the work.",
      "fontSize": 18,
      "strokeColor": "#62677d",
      "fontFamily": 2,
      "width": 1082.52,
      "height": 22.5
    }
